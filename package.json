{
  "name": "part-shift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync-data": "node scripts/sync-data.mjs ..",
    "artifact": "ARTIFACT=1 vite build && node scripts/build-artifact.mjs",
    "learning-artifact": "LEARNING=1 vite build && node scripts/build-learning-artifact.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@colyseus/core": "^0.18.18",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
