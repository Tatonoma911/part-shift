      "totalBudget": 2
    },
    "adaptant": {
      "partDropChance": 1.0,
      "partSlot": "arm"
    },
    "nestTech": "cryo"
  },
  "steps": [
    {
      "id": 1,
      "text": "tutorial.step1",
      "highlight": [
        [
          3,
          8
        ]
      ],
      "until": "command_placed"
    },
    {
      "id": 2,
      "text": "tutorial.step2",
      "highlight": [
        [
          2,
          6
        ],
        [
          3,
          6
        ],
        [
          4,
          6
        ]
      ],
      "until": "cells_queued:3"
    },
    {
      "id": 3,
      "text": "tutorial.step3",
      "until": "first_zero_cascade_done",
      "autoAdvanceSeconds": 6,
      "minSeconds": 3
    },
    {
      "id": 4,
      "text": "tutorial.step4",
      "focus": "first_threat_clue",
      "until": "clue_touched"
    },
    {
      "id": 5,
      "text": "tutorial.step5",
      "focus": "overlapping_threat_clues",
