{
  "version": "0.1",
  "id": "tutorial_first_shift",
  "name_key": "tutorial.title",
  "width": 8,
  "height": 10,
  "_note": "Hand-made tutorial map (ONBOARDING.md §2). Interim file by game designer until the level designer owns design/levels/.",
  "layout": [
    "........",
    "........",
    "......C.",
    "..N.....",
    "........",
    "........",
    "R.......",
    ".......~",
    "...K...~",
    "........"
  ],
  "legend": {
    ".": "ground",
    "C": "cache",
    "N": "nest",
    "R": "rubble",
    "~": "water",
    "K": "command"
  },
  "commandFixed": {
    "x": 3,
    "y": 8
  },
  "initiallyRevealedRadius": 1,
  "overrides": {
    "config.dig.digSeconds": 3,
    "config.population.spawnSeconds": 8,
    "config.economy.startEnergy": 300,
