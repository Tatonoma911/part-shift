      "minSeconds": 6
    },
    {
      "id": 6,
      "text": "tutorial.step6",
      "highlightBuild": [
        "home",
        "school"
      ],
      "until": "defenders_trained:2"
    },
    {
      "id": 7,
      "text": "tutorial.step7",
      "focus": "nest_cell",
      "until": "nest_opened"
    },
    {
      "id": 8,
      "text": "tutorial.step8",
      "until": "part_attached",
      "minSeconds": 3
    },
    {
      "id": 9,
      "text": "tutorial.step9",
      "focus": "cache_cell",
      "until": "cache_opened"
    }
